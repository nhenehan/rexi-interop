<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:interop:telemetry"
           xmlns="urn:interop:telemetry"
           elementFormDefault="qualified">

  <xs:complexType name="ReadingType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="value" type="xs:decimal"/>
      <xs:element name="unit" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TelemetryPacketType">
    <xs:sequence>
      <xs:element name="deviceId" type="xs:string"/>
      <xs:element name="timestamp" type="xs:dateTime"/>
      <xs:element name="reading" type="ReadingType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="TelemetryPacket" type="TelemetryPacketType"/>
</xs:schema>
