<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:interop:poly"
           xmlns="urn:interop:poly"
           elementFormDefault="qualified">

  <xs:complexType name="AlarmEntryType">
    <xs:sequence>
      <xs:element name="code" type="xs:string"/>
      <xs:element name="level" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EventEntryType">
    <xs:sequence>
      <xs:element name="category" type="xs:string"/>
      <xs:element name="message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EnvelopeType">
    <xs:sequence>
      <xs:element name="batchId" type="xs:string"/>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="alarm" type="AlarmEntryType"/>
        <xs:element name="event" type="EventEntryType"/>
      </xs:choice>
      <xs:element name="status" type="xs:string"/>
      <xs:element name="summary" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Envelope" type="EnvelopeType"/>
</xs:schema>
