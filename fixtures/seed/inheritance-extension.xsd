<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:interop:inheritance"
           xmlns="urn:interop:inheritance"
           elementFormDefault="qualified">

  <xs:complexType name="BaseEventType">
    <xs:sequence>
      <xs:element name="eventId" type="xs:string"/>
      <xs:element name="sensorId" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReadingEventType">
    <xs:complexContent>
      <xs:extension base="BaseEventType">
        <xs:sequence>
          <xs:element name="readingType" type="xs:string"/>
          <xs:element name="value" type="xs:decimal"/>
          <xs:element name="unit" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="ReadingEvent" type="ReadingEventType"/>
</xs:schema>
